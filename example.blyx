use batchquota;

fn main() {
    let done = 4.0;
    let total = 10.0;
    let limit = 3.0;
    let result = batchquota_allow(done, total, limit);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
